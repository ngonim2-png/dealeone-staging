# Local dev default matches the Postgres role/db created in this workspace.
# On Render, set DATABASE_URL to the managed Postgres connection string it gives you.
DATABASE_URL="postgresql://dealeone:dealeone_dev_pw@localhost:5432/dealeone"
PORT=4000
CORS_ORIGIN="http://localhost:5173"

# Signs login session tokens — generate a real random value per environment, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Never reuse the same secret across dev/staging/prod, and never commit a real one.
JWT_SECRET="replace-with-a-random-64-char-hex-string"

# ---- Optional ------------------------------------------------------------------------
# Secret for the read-only weekly numbers link (GET /api/stats/summary) and for triggering
# reminders from outside (POST /api/stats/run-reminders). At least 24 random characters:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# REPORT_TOKEN=
# Listings are free until this date (launch promotion), e.g. 2027-03-01. Leave unset to charge.
# FREE_LISTINGS_UNTIL=
# Turns on "Fill in from my photo" (and future AI features). Never commit a real key.
# ANTHROPIC_API_KEY=
# ASSIST_MODEL=
# Automatic reminder messages run every 30 minutes by default; set to "off" to stop them.
# REMINDERS=off
# Web push keys (generated and stored automatically if unset).
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
